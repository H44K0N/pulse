# Example nginx server block for a conventional host that terminates TLS
# itself. (Not needed when the app is exposed through a Cloudflare Tunnel; see
# DEPLOY.md.) Replace pulse.example.com and the certificate paths, e.g. with
# certificates from `certbot certonly --nginx -d pulse.example.com`.

server {
    listen 80;
    listen [::]:80;
    server_name pulse.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name pulse.example.com;

    ssl_certificate     /etc/letsencrypt/live/pulse.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pulse.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:pulse_ssl:1m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;

    # Matches the app's 10 MiB limit (PULSE_MAX_BODY_BYTES). nginx's "10m" is
    # 10 MiB, so oversized uploads get the same 413 from either layer.
    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:8200;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
