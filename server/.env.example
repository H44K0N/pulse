# Copy to .env (never commit .env). Generate the token with: openssl rand -hex 32
# The server refuses to start if this is missing or shorter than 32 characters.
PULSE_API_TOKEN=replace-me-with-output-of-openssl-rand-hex-32

# Optional; defaults shown.
# PULSE_DB_PATH=/data/pulse.db
# PULSE_MAX_BODY_BYTES=10485760
