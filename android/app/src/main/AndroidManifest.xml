<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The app is useless without Bluetooth Low Energy (the H10 is a BLE device). -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!--
        Bluetooth runtime permissions (Android 12+; minSdk is 33 so the old location-based
        model never applies).
        neverForLocation: we promise the system we never derive location from scan results.
        Polar's README explicitly allows this flag for its SDK. Effect: no location permission
        is needed and location services do not have to be on to scan. Side effect (documented
        by Android): some BLE beacons are filtered out of scan results; the H10 is not a beacon.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Android 13+: needed for the session notification (current HR / phase) to be visible. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Foreground service for the running session. Android 14+ requires every foreground
        service to declare a type AND hold the matching FOREGROUND_SERVICE_<TYPE> permission.
        "connectedDevice" is the type for "talking to an external device over Bluetooth"; it is
        not subject to the time limits Android 15 put on dataSync/mediaProcessing services.
        Its runtime prerequisite (checked by the system when the service starts) is holding
        BLUETOOTH_CONNECT, which is why the app asks for it even in simulator mode.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!--
        A foreground service keeps the process alive, but it does NOT keep the CPU awake. With
        the screen off the phone may suspend between Bluetooth packets, so timers (phase changes,
        "sensor lost" after 10 s without data) could fire late. The session holds a partial
        wake lock (CPU only, screen stays off) while it runs.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        The Polar SDK's own manifest adds these for its optional Companion Device Manager
        feature, which this app does not enable. Removed so the app asks for nothing it does
        not use. Remove these two lines if FEATURE_COMPANION_DEVICE_MANAGEMENT is ever used.
    -->
    <uses-permission
        android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE"
        tools:node="remove" />

    <!--
        No cloud backup: the database holds health data and DataStore holds the server API
        token. allowBackup=false covers Android 12 and older behaviour; dataExtractionRules
        (Android 12+) says the same for cloud backup and allows moving to a new phone.
    -->
    <application
        android:name=".PulseApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pulse">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not exported: only this app (UI and its own notification buttons) controls sessions. -->
        <service
            android:name=".session.SessionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
