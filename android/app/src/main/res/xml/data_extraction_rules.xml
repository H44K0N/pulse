<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup rules.
    Cloud backup: nothing. The database is health data and DataStore holds the server API
    token; neither should end up in a cloud backup account. (The sync server is the backup.)
    Device-to-device transfer (moving to a new phone with a cable or Wi-Fi Direct): everything,
    so session history and settings come along.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
